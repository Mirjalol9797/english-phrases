      },
      "phrases": [
        {
          "id": "EE091",
          "en": "I see.",
          "ru": "Понятно.",
          "uz": "Tushunarli."
        },
        {
          "id": "EE092",
          "en": "I understand.",
          "ru": "Я понимаю.",
          "uz": "Tushunyapman."
        },
        {
          "id": "EE093",
          "en": "I don't understand.",
          "ru": "Я не понимаю.",
          "uz": "Tushunmayapman."
        },
        {
