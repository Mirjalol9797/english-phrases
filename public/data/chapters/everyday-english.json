          "ru": "Добрый вечер!",
          "uz": "Xayrli kech!"
        },
        {
          "id": "EE007",
          "en": "How are you?",
          "ru": "Как дела?",
          "uz": "Qalaysiz?"
        },
        {
          "id": "EE008",
          "en": "How's it going?",
          "ru": "Как дела? / Как оно?",
