        },
        {
          "id": "EE088",
          "en": "No worries.",
          "ru": "Ничего страшного.",
          "uz": "Hechqisi yoʻq."
        },
        {
          "id": "EE089",
          "en": "That's okay.",
          "ru": "Всё нормально.",
          "uz": "Hammasi joyida."
        },
        {
          "id": "EE090",
          "en": "It happens.",
          "ru": "Бывает.",
          "uz": "Bunday boʻlib turadi."
        }
      ]
