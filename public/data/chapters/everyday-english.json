          "en": "I'm having lunch.",
          "ru": "Я обедаю.",
          "uz": "Tushlik qilyapman."
        },
        {
          "id": "EE047",
          "en": "I'm working right now.",
          "ru": "Я сейчас работаю.",
          "uz": "Hozir ishlayapman."
        },
        {
          "id": "EE048",
          "en": "I'm going home.",
          "ru": "Я иду / еду домой.",
