    {
      "id": "EE-L06",
      "order": 6,
      "title": {
        "en": "Making plans",
        "ru": "Договариваемся о встрече",
        "uz": "Uchrashuvga kelishish"
      },
      "phrases": [
        {
          "id": "EE051",
          "en": "Are you free today?",
          "ru": "Ты сегодня свободен / свободна?",
          "uz": "Bugun boʻshmisiz?"
        },
        {
          "id": "EE052",
          "en": "Are you doing anything tonight?",
          "ru": "Ты чем-нибудь занят(а) сегодня вечером?",
          "uz": "Bugun kechqurun bandmisiz?"
        },
        {
          "id": "EE053",
          "en": "Do you want to hang out?",
          "ru": "Хочешь провести время вместе?",
          "uz": "Birga vaqt oʻtkazmaymizmi?"
        },
        {
          "id": "EE054",
          "en": "Let's meet up.",
          "ru": "Давай встретимся.",
          "uz": "Keling, uchrashaylik."
        },
        {
          "id": "EE055",
          "en": "Let's go for a walk.",
          "ru": "Давай прогуляемся.",
          "uz": "Keling, sayr qilaylik."
        },
        {
          "id": "EE056",
          "en": "What time works for you?",
          "ru": "Какое время тебе подходит?",
          "uz": "Sizga qaysi vaqt qulay?"
        },
        {
          "id": "EE057",
          "en": "Where shall we meet?",
          "ru": "Где встретимся?",
          "uz": "Qayerda uchrashamiz?"
        },
        {
          "id": "EE058",
          "en": "That sounds good.",
          "ru": "Звучит хорошо.",
          "uz": "Yaxshi tuyuladi."
        },
        {
          "id": "EE059",
          "en": "I'm not sure yet.",
          "ru": "Я пока не уверен(а).",
          "uz": "Hali aniq bilmayman."
        },
        {
          "id": "EE060",
          "en": "I'll let you know.",
          "ru": "Я дам тебе знать.",
          "uz": "Sizga xabar beraman."
        }
      ]
    },
    {
