        },
        {
          "id": "EE024",
          "en": "Everything okay?",
          "ru": "Всё в порядке?",
          "uz": "Hammasi joyidami?"
        },
        {
          "id": "EE025",
          "en": "Is everything all right?",
          "ru": "Всё хорошо?",
          "uz": "Hammasi yaxshimi?"
        },
        {
          "id": "EE026",
          "en": "What's new?",
          "ru": "Что нового?",
          "uz": "Nima yangiliklar?"
        },
        {
          "id": "EE027",
          "en": "Anything new?",
          "ru": "Есть что-нибудь новенькое?",
          "uz": "Yangilik bormi?"
        },
        {
          "id": "EE028",
          "en": "I'm good, thanks.",
          "ru": "У меня всё хорошо, спасибо.",
          "uz": "Yaxshi, rahmat."
        },
        {
          "id": "EE029",
          "en": "Pretty good, thanks.",
          "ru": "Довольно хорошо, спасибо.",
          "uz": "Ancha yaxshi, rahmat."
        },
        {
          "id": "EE030",
          "en": "Not bad.",
          "ru": "Неплохо.",
          "uz": "Yomon emas."
        }
      ]
    },
    {
      "id": "EE-L04",
      "order": 4,
      "title": {
        "en": "Introducing yourself",
        "ru": "Знакомство",
        "uz": "Tanishuv"
      },
      "phrases": [
        {
          "id": "EE031",
          "en": "What's your name?",
          "ru": "Как тебя зовут?",
          "uz": "Ismingiz nima?"
        },
        {
          "id": "EE032",
          "en": "My name is ...",
          "ru": "Меня зовут ...",
          "uz": "Mening ismim ..."
        },
        {
          "id": "EE033",
          "en": "You can call me ...",
          "ru": "Можешь называть меня ...",
          "uz": "Meni ... deb chaqirsangiz boʻladi."
        },
        {
          "id": "EE034",
          "en": "Nice to meet you.",
          "ru": "Приятно познакомиться.",
          "uz": "Tanishganimdan xursandman."
        },
        {
          "id": "EE035",
          "en": "Nice to meet you, too.",
          "ru": "Мне тоже приятно познакомиться.",
          "uz": "Men ham tanishganimdan xursandman."
        },
        {
          "id": "EE036",
          "en": "Where are you from?",
          "ru": "Откуда ты?",
          "uz": "Qayerdansiz?"
        },
        {
          "id": "EE037",
          "en": "I'm from Uzbekistan.",
          "ru": "Я из Узбекистана.",
          "uz": "Men Oʻzbekistondanman."
        },
        {
          "id": "EE038",
          "en": "Where do you live?",
          "ru": "Где ты живёшь?",
          "uz": "Qayerda yashaysiz?"
        },
        {
          "id": "EE039",
          "en": "I live in Tashkent.",
          "ru": "Я живу в Ташкенте.",
          "uz": "Men Toshkentda yashayman."
        },
        {
          "id": "EE040",
          "en": "What do you do?",
          "ru": "Кем ты работаешь? / Чем занимаешься?",
          "uz": "Nima ish qilasiz?"
        }
      ]
    },
    {
      "id": "EE-L05",
