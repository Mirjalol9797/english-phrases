        },
        {
          "id": "EE062",
          "en": "Do you want to come with me?",
          "ru": "Хочешь пойти со мной?",
          "uz": "Men bilan borasizmi?"
        },
        {
          "id": "EE063",
          "en": "Sure, why not?",
          "ru": "Конечно, почему бы и нет?",
          "uz": "Albatta, nega boʻlmasin?"
        },
        {
          "id": "EE064",
          "en": "I'd love to.",
          "ru": "С удовольствием.",
          "uz": "Bajonidil."
        },
        {
          "id": "EE065",
          "en": "That sounds like fun.",
          "ru": "Звучит весело.",
          "uz": "Qiziqarli boʻladiganga oʻxshaydi."
        },
