  },
  "lessons": [
    {
      "id": "QR-L01",
      "order": 1,
      "title": {
        "en": "Asking basic questions",
        "ru": "Простые вопросы",
        "uz": "Oddiy savollar"
      },
      "phrases": [
        {
          "id": "QR001",
          "en": "What is this?",
          "ru": "Что это?",
          "uz": "Bu nima?"
        },
        {
          "id": "QR002",
          "en": "Who is that?",
          "ru": "Кто это?",
          "uz": "U kim?"
        },
        {
          "id": "QR003",
          "en": "Where are you going?",
          "ru": "Куда ты идёшь?",
          "uz": "Qayerga ketyapsiz?"
        },
        {
          "id": "QR004",
          "en": "When does it start?",
          "ru": "Когда это начинается?",
          "uz": "U qachon boshlanadi?"
        },
        {
          "id": "QR005",
          "en": "Why are you asking?",
          "ru": "Почему ты спрашиваешь?",
          "uz": "Nega soʻrayapsiz?"
        },
        {
          "id": "QR006",
          "en": "Which one do you prefer?",
          "ru": "Какой из них ты предпочитаешь?",
          "uz": "Qaysi birini afzal koʻrasiz?"
        },
        {
          "id": "QR007",
          "en": "How does it work?",
          "ru": "Как это работает?",
          "uz": "Bu qanday ishlaydi?"
        },
        {
          "id": "QR008",
          "en": "How much does it cost?",
          "ru": "Сколько это стоит?",
          "uz": "Bu qancha turadi?"
        },
        {
          "id": "QR009",
          "en": "How long will it take?",
          "ru": "Сколько времени это займёт?",
          "uz": "Bu qancha vaqt oladi?"
        },
        {
          "id": "QR010",
          "en": "How often do you do that?",
          "ru": "Как часто ты это делаешь?",
          "uz": "Buni qanchalik tez-tez qilasiz?"
        }
      ]
    },
    {
      "id": "QR-L02",
      "order": 2,
      "title": {
        "en": "Asking for information",
        "ru": "Запрос информации",
        "uz": "Maʼlumot soʻrash"
      },
      "phrases": [
        {
          "id": "QR011",
          "en": "Could you give me some information?",
          "ru": "Не могли бы вы дать мне информацию?",
          "uz": "Menga biroz maʼlumot bera olasizmi?"
        },
        {
          "id": "QR012",
          "en": "Could you tell me more about it?",
          "ru": "Не могли бы вы рассказать об этом подробнее?",
          "uz": "Bu haqda batafsilroq aytib bera olasizmi?"
        },
        {
          "id": "QR013",
          "en": "Where can I find more details?",
          "ru": "Где я могу найти подробности?",
          "uz": "Batafsil maʼlumotni qayerdan topsam boʻladi?"
        },
        {
          "id": "QR014",
          "en": "Do you know what time it opens?",
          "ru": "Вы знаете, во сколько это открывается?",
          "uz": "Bu necha soatda ochilishini bilasizmi?"
        },
        {
          "id": "QR015",
          "en": "Could you explain how it works?",
          "ru": "Не могли бы вы объяснить, как это работает?",
          "uz": "Bu qanday ishlashini tushuntira olasizmi?"
        },
        {
          "id": "QR016",
          "en": "Is there anything else I should know?",
          "ru": "Есть ли ещё что-нибудь, что мне следует знать?",
          "uz": "Yana bilishim kerak boʻlgan narsa bormi?"
        },
        {
          "id": "QR017",
          "en": "Could you clarify one thing?",
          "ru": "Не могли бы вы кое-что уточнить?",
          "uz": "Bir narsani aniqlashtira olasizmi?"
        },
        {
          "id": "QR018",
          "en": "What does this mean?",
          "ru": "Что это означает?",
          "uz": "Bu nimani anglatadi?"
        },
        {
          "id": "QR019",
          "en": "Where did you hear that?",
          "ru": "Где ты это услышал(а)?",
          "uz": "Buni qayerdan eshitdingiz?"
        },
        {
          "id": "QR020",
          "en": "Could you point me to the right source?",
          "ru": "Не могли бы вы указать мне подходящий источник?",
          "uz": "Menga kerakli manbani koʻrsata olasizmi?"
        }
      ]
    },
    {
      "id": "QR-L03",
      "order": 3,
      "title": {
        "en": "Polite requests",
        "ru": "Вежливые просьбы",
        "uz": "Xushmuomala iltimoslar"
      },
      "phrases": [
        {
          "id": "QR021",
          "en": "Could you help me, please?",
          "ru": "Не могли бы вы мне помочь?",
          "uz": "Iltimos, menga yordam bera olasizmi?"
        },
        {
          "id": "QR022",
          "en": "Would you mind opening the window?",
          "ru": "Не могли бы вы открыть окно?",
          "uz": "Derazani ochib bera olasizmi?"
        },
        {
          "id": "QR023",
          "en": "Could I ask you a favour?",
          "ru": "Можно попросить вас об услуге?",
          "uz": "Sizdan bir iltimos qilsam boʻladimi?"
        },
        {
          "id": "QR024",
          "en": "Would it be possible to reschedule?",
          "ru": "Можно ли перенести встречу?",
          "uz": "Uchrashuvni boshqa vaqtga koʻchirish mumkinmi?"
        },
        {
          "id": "QR025",
          "en": "Could you send it to me, please?",
          "ru": "Не могли бы вы отправить это мне?",
          "uz": "Iltimos, buni menga yuborib bera olasizmi?"
        },
        {
          "id": "QR026",
          "en": "Would you mind waiting a moment?",
          "ru": "Не могли бы вы подождать минутку?",
          "uz": "Bir daqiqa kutib tura olasizmi?"
        },
        {
          "id": "QR027",
          "en": "Could you speak a little more slowly?",
          "ru": "Не могли бы вы говорить немного медленнее?",
          "uz": "Biroz sekinroq gapira olasizmi?"
        },
        {
          "id": "QR028",
          "en": "May I ask you a question?",
          "ru": "Можно задать вам вопрос?",
          "uz": "Sizga bir savol bersam boʻladimi?"
        },
        {
          "id": "QR029",
          "en": "Could you show me how to do it?",
          "ru": "Не могли бы вы показать, как это сделать?",
          "uz": "Buni qanday qilishni koʻrsata olasizmi?"
        },
        {
          "id": "QR030",
          "en": "Would you be able to help tomorrow?",
          "ru": "Вы смогли бы помочь завтра?",
          "uz": "Ertaga yordam bera olasizmi?"
        }
      ]
    },
    {
      "id": "QR-L04",
      "order": 4,
      "title": {
        "en": "Asking someone to repeat",
        "ru": "Просьба повторить",
        "uz": "Takrorlashni soʻrash"
      },
      "phrases": [
        {
          "id": "QR031",
          "en": "Could you repeat that, please?",
          "ru": "Не могли бы вы повторить?",
          "uz": "Iltimos, buni takrorlay olasizmi?"
        },
        {
          "id": "QR032",
          "en": "Sorry, what was that?",
          "ru": "Извините, что вы сказали?",
          "uz": "Kechirasiz, nima dedingiz?"
        },
        {
          "id": "QR033",
          "en": "Could you say that one more time?",
          "ru": "Не могли бы вы сказать это ещё раз?",
          "uz": "Buni yana bir marta ayta olasizmi?"
        },
        {
          "id": "QR034",
          "en": "I didn't quite catch that.",
          "ru": "Я не совсем расслышал(а).",
          "uz": "Men buni unchalik eshitmadim."
        },
        {
          "id": "QR035",
          "en": "Could you spell that for me?",
          "ru": "Не могли бы вы произнести это по буквам?",
          "uz": "Buni harflab ayta olasizmi?"
        },
        {
          "id": "QR036",
          "en": "Would you mind speaking up?",
          "ru": "Не могли бы вы говорить громче?",
          "uz": "Balandroq gapira olasizmi?"
        },
        {
          "id": "QR037",
          "en": "Could you write it down?",
          "ru": "Не могли бы вы это записать?",
          "uz": "Buni yozib bera olasizmi?"
        },
        {
          "id": "QR038",
          "en": "Did you say fifteen or fifty?",
          "ru": "Вы сказали пятнадцать или пятьдесят?",
          "uz": "Oʻn besh dedingizmi yoki ellik?"
        },
        {
          "id": "QR039",
          "en": "Could you explain that in another way?",
          "ru": "Не могли бы вы объяснить это по-другому?",
          "uz": "Buni boshqacha tushuntira olasizmi?"
        },
        {
          "id": "QR040",
          "en": "Let me make sure I heard you correctly.",
          "ru": "Позвольте убедиться, что я правильно вас услышал(а).",
          "uz": "Sizni toʻgʻri eshitganimga ishonch hosil qilay."
        }
      ]
    },
    {
      "id": "QR-L05",
      "order": 5,
      "title": {
        "en": "Asking for directions",
        "ru": "Вопросы о дороге",
        "uz": "Yoʻl haqida savollar"
      },
      "phrases": [
        {
          "id": "QR041",
          "en": "How do I get there?",
          "ru": "Как мне туда добраться?",
          "uz": "U yerga qanday boraman?"
        },
        {
          "id": "QR042",
          "en": "Which way should I go?",
          "ru": "В какую сторону мне идти?",
          "uz": "Qaysi tomonga borishim kerak?"
        },
        {
          "id": "QR043",
          "en": "Is it far from here?",
          "ru": "Это далеко отсюда?",
          "uz": "Bu yerdan uzoqmi?"
        },
        {
          "id": "QR044",
          "en": "Could you show me on the map?",
          "ru": "Не могли бы вы показать на карте?",
          "uz": "Xaritada koʻrsata olasizmi?"
        },
        {
          "id": "QR045",
          "en": "Where is the nearest bus stop?",
          "ru": "Где ближайшая автобусная остановка?",
          "uz": "Eng yaqin avtobus bekati qayerda?"
        },
        {
          "id": "QR046",
          "en": "Should I turn left or right?",
          "ru": "Мне повернуть налево или направо?",
          "uz": "Chapga burilaymi yoki oʻngga?"
        },
        {
          "id": "QR047",
          "en": "How many stops should I go?",
          "ru": "Сколько остановок мне ехать?",
          "uz": "Necha bekat yurishim kerak?"
        },
        {
          "id": "QR048",
          "en": "Can I walk there?",
          "ru": "Я могу дойти туда пешком?",
          "uz": "U yerga piyoda bora olamanmi?"
        },
        {
          "id": "QR049",
          "en": "Is this the right way?",
          "ru": "Я иду в правильном направлении?",
          "uz": "Men toʻgʻri ketyapmanmi?"
        },
        {
          "id": "QR050",
          "en": "Could you tell me when to get off?",
          "ru": "Не могли бы вы сказать, когда выходить?",
          "uz": "Qachon tushishimni ayta olasizmi?"
        }
      ]
    },
    {
      "id": "QR-L06",
      "order": 6,
      "title": {
        "en": "Asking for permission",
        "ru": "Просьба о разрешении",
        "uz": "Ruxsat soʻrash"
      },
      "phrases": [
        {
          "id": "QR051",
          "en": "May I come in?",
          "ru": "Можно войти?",
          "uz": "Kirsam boʻladimi?"
        },
        {
          "id": "QR052",
          "en": "Can I use your phone?",
          "ru": "Можно воспользоваться твоим телефоном?",
          "uz": "Telefoningizdan foydalansam boʻladimi?"
        },
        {
          "id": "QR053",
          "en": "Would it be okay if I left early?",
          "ru": "Ничего, если я уйду пораньше?",
          "uz": "Erta ketsam boʻladimi?"
        },
        {
          "id": "QR054",
          "en": "Do you mind if I sit here?",
          "ru": "Ты не против, если я сяду здесь?",
          "uz": "Bu yerga oʻtirsam, qarshi emasmisiz?"
        },
        {
          "id": "QR055",
          "en": "May I borrow this for a moment?",
          "ru": "Можно одолжить это на минутку?",
          "uz": "Buni bir daqiqaga olib tursam boʻladimi?"
        },
        {
          "id": "QR056",
          "en": "Is it all right if I bring a friend?",
          "ru": "Ничего, если я приведу друга?",
          "uz": "Doʻstimni olib kelsam boʻladimi?"
        },
        {
          "id": "QR057",
          "en": "Could I take a day off?",
          "ru": "Могу я взять выходной?",
          "uz": "Bir kun dam olsam boʻladimi?"
        },
        {
          "id": "QR058",
          "en": "Would you mind if I opened the window?",
          "ru": "Вы не возражаете, если я открою окно?",
          "uz": "Derazani ochsam, qarshi emasmisiz?"
        },
        {
          "id": "QR059",
          "en": "Am I allowed to park here?",
          "ru": "Мне разрешено здесь парковаться?",
          "uz": "Bu yerga toʻxtashga ruxsat bormi?"
        },
        {
          "id": "QR060",
          "en": "Can I ask you something personal?",
          "ru": "Можно спросить тебя о личном?",
          "uz": "Shaxsiy bir narsa soʻrasam boʻladimi?"
        }
      ]
    },
    {
      "id": "QR-L07",
      "order": 7,
      "title": {
        "en": "Offering help",
        "ru": "Предложение помощи",
        "uz": "Yordam taklif qilish"
      },
      "phrases": [
        {
          "id": "QR061",
          "en": "Can I help you with that?",
          "ru": "Могу я помочь тебе с этим?",
          "uz": "Bunda sizga yordam bera olamanmi?"
        },
        {
          "id": "QR062",
          "en": "Would you like a hand?",
          "ru": "Тебе помочь?",
          "uz": "Yordam kerakmi?"
        },
        {
          "id": "QR063",
          "en": "Shall I carry that for you?",
          "ru": "Мне понести это за тебя?",
          "uz": "Buni koʻtarib beraymi?"
        },
        {
          "id": "QR064",
          "en": "Do you need any help?",
          "ru": "Тебе нужна помощь?",
          "uz": "Yordam kerakmi?"
        },
        {
          "id": "QR065",
          "en": "Can I get you anything?",
          "ru": "Могу я тебе что-нибудь принести?",
          "uz": "Sizga biror narsa olib kelaymi?"
        },
        {
          "id": "QR066",
          "en": "Would you like me to call someone?",
          "ru": "Хочешь, я кому-нибудь позвоню?",
          "uz": "Birortasiga qoʻngʻiroq qilaymi?"
        },
        {
          "id": "QR067",
          "en": "Let me know if you need anything.",
          "ru": "Дай знать, если что-нибудь понадобится.",
          "uz": "Biror narsa kerak boʻlsa, ayting."
        },
        {
          "id": "QR068",
          "en": "Can I do anything to help?",
          "ru": "Могу я чем-нибудь помочь?",
          "uz": "Yordam berish uchun biror ish qila olamanmi?"
        },
        {
          "id": "QR069",
          "en": "Would it help if I came earlier?",
          "ru": "Помогло бы, если бы я пришёл / пришла раньше?",
          "uz": "Erta kelsam yordam boʻlarmidi?"
        },
        {
          "id": "QR070",
          "en": "I'll be happy to help.",
          "ru": "Я буду рад(а) помочь.",
          "uz": "Yordam berishdan xursand boʻlaman."
        }
      ]
    },
    {
      "id": "QR-L08",
      "order": 8,
      "title": {
        "en": "Asking for clarification",
        "ru": "Уточняющие вопросы",
        "uz": "Aniqlashtiruvchi savollar"
      },
      "phrases": [
        {
          "id": "QR071",
          "en": "What exactly do you mean?",
          "ru": "Что именно ты имеешь в виду?",
          "uz": "Aniq nimani nazarda tutyapsiz?"
        },
        {
          "id": "QR072",
          "en": "Could you be more specific?",
          "ru": "Не могли бы вы уточнить?",
          "uz": "Aniqroq ayta olasizmi?"
        },
        {
          "id": "QR073",
          "en": "Which part are you referring to?",
          "ru": "Какую именно часть вы имеете в виду?",
          "uz": "Qaysi qismini nazarda tutyapsiz?"
        },
        {
          "id": "QR074",
          "en": "Do you mean this one?",
          "ru": "Ты имеешь в виду вот этот?",
          "uz": "Shunisini nazarda tutyapsizmi?"
        },
        {
          "id": "QR075",
          "en": "Could you give me an example?",
          "ru": "Не могли бы вы привести пример?",
          "uz": "Misol keltira olasizmi?"
        },
        {
          "id": "QR076",
          "en": "Are you saying that we need to wait?",
          "ru": "Ты говоришь, что нам нужно подождать?",
          "uz": "Kutishimiz kerak demoqchimisiz?"
        },
        {
          "id": "QR077",
          "en": "Did I understand you correctly?",
          "ru": "Я правильно тебя понял(а)?",
          "uz": "Sizni toʻgʻri tushundimmi?"
        },
        {
          "id": "QR078",
          "en": "Can you explain why?",
          "ru": "Можешь объяснить почему?",
          "uz": "Nega ekanini tushuntira olasizmi?"
        },
        {
          "id": "QR079",
          "en": "What do you mean by 'urgent'?",
          "ru": "Что ты имеешь в виду под словом «срочно»?",
          "uz": "«Shoshilinch» deganda nimani nazarda tutyapsiz?"
        },
        {
          "id": "QR080",
          "en": "Could you clarify the last point?",
          "ru": "Не могли бы вы уточнить последний пункт?",
          "uz": "Oxirgi fikrni aniqlashtira olasizmi?"
        }
      ]
    },
    {
      "id": "QR-L09",
      "order": 9,
      "title": {
        "en": "Making requests at work",
        "ru": "Просьбы на работе",
        "uz": "Ishdagi iltimoslar"
      },
      "phrases": [
        {
          "id": "QR081",
          "en": "Could you review this document?",
          "ru": "Не могли бы вы проверить этот документ?",
          "uz": "Bu hujjatni koʻrib chiqa olasizmi?"
        },
        {
          "id": "QR082",
          "en": "Can you send me the latest version?",
          "ru": "Можете отправить мне последнюю версию?",
          "uz": "Menga oxirgi versiyasini yuborib bera olasizmi?"
        },
        {
          "id": "QR083",
          "en": "Could you finish this by Friday?",
          "ru": "Не могли бы вы закончить это к пятнице?",
          "uz": "Buni juma kunigacha tugata olasizmi?"
        },
        {
          "id": "QR084",
          "en": "Would you mind checking these numbers?",
          "ru": "Не могли бы вы проверить эти цифры?",
          "uz": "Bu raqamlarni tekshirib bera olasizmi?"
        },
        {
          "id": "QR085",
          "en": "Can we move the meeting to tomorrow?",
          "ru": "Можем перенести встречу на завтра?",
          "uz": "Uchrashuvni ertaga koʻchira olamizmi?"
        },
        {
          "id": "QR086",
          "en": "Could you keep me in the loop?",
          "ru": "Не могли бы вы держать меня в курсе?",
          "uz": "Meni xabardor qilib turasizmi?"
        },
        {
          "id": "QR087",
          "en": "Please let me know when it's ready.",
          "ru": "Пожалуйста, сообщите, когда будет готово.",
          "uz": "Tayyor boʻlganda, iltimos, xabar bering."
        },
        {
          "id": "QR088",
          "en": "Could you share the meeting notes?",
          "ru": "Не могли бы вы поделиться заметками со встречи?",
          "uz": "Uchrashuv yozuvlarini ulasha olasizmi?"
        },
        {
          "id": "QR089",
          "en": "Would you be able to take this on?",
          "ru": "Вы смогли бы взять это на себя?",
          "uz": "Buni oʻz zimmangizga ola olasizmi?"
        },
        {
          "id": "QR090",
          "en": "Could you give me a quick update?",
          "ru": "Не могли бы вы кратко сообщить новости?",
          "uz": "Qisqacha yangilik aytib bera olasizmi?"
        }
      ]
    },
    {
      "id": "QR-L10",
      "order": 10,
      "title": {
        "en": "Requests in shops and cafés",
        "ru": "Просьбы в магазинах и кафе",
        "uz": "Doʻkon va kafedagi iltimoslar"
      },
      "phrases": [
        {
          "id": "QR091",
          "en": "Could I see the menu, please?",
          "ru": "Можно меню, пожалуйста?",
          "uz": "Iltimos, menyuni koʻrsam boʻladimi?"
        },
        {
          "id": "QR092",
          "en": "Can I try this on?",
          "ru": "Можно это примерить?",
          "uz": "Buni kiyib koʻrsam boʻladimi?"
        },
        {
          "id": "QR093",
          "en": "Could I have a receipt?",
          "ru": "Можно чек?",
          "uz": "Chek olsam boʻladimi?"
        },
