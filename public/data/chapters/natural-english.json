        {
          "id": "NE045",
          "en": "More or less",
          "ru": "Более или менее."
        },
        {
          "id": "NE046",
          "en": "A bunch of",
          "ru": "Много; целая куча."
        },
        {
          "id": "NE047",
          "en": "Loads of",
          "ru": "Очень много."
        },
