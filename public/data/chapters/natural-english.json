{
  "id": "natural-english",
  "order": 10,
  "prefix": "NE",
  "kind": "phrases",
  "title": {
    "en": "Natural English",
    "ru": "Естественный разговорный английский",
    "uz": "Tabiiy soʻzlashuv ingliz tili"
  },
  "lessons": [
    {
      "id": "NE-L01",
      "order": 1,
      "title": {
        "en": "Natural reactions",
        "ru": "Естественные реакции",
        "uz": "Tabiiy javob-munosabatlar"
      },
      "phrases": [
        {
          "id": "NE001",
          "en": "No way!",
          "ru": "Да ладно! / Не может быть!",
          "uz": "Qoʻysangiz-chi! / Boʻlishi mumkin emas!"
        },
        {
          "id": "NE002",
          "en": "You must be kidding.",
          "ru": "Ты, должно быть, шутишь.",
          "uz": "Hazillashyapsiz shekilli."
        },
        {
          "id": "NE003",
          "en": "That figures.",
          "ru": "Так и думал(а). / Неудивительно.",
          "uz": "Shunday deb oʻylagandim. / Ajablanarli emas."
        },
        {
          "id": "NE004",
          "en": "Fair enough.",
          "ru": "Ладно, справедливо.",
          "uz": "Mayli, toʻgʻri."
        },
        {
          "id": "NE005",
          "en": "I get it.",
          "ru": "Понимаю.",
          "uz": "Tushundim."
        },
        {
          "id": "NE006",
          "en": "Makes sense.",
          "ru": "Логично.",
          "uz": "Mantiqli."
        },
        {
          "id": "NE007",
          "en": "Good point.",
          "ru": "Хорошее замечание.",
          "uz": "Yaxshi fikr."
        },
        {
          "id": "NE008",
          "en": "I hear you.",
          "ru": "Я тебя понимаю.",
          "uz": "Sizni tushunaman."
        },
        {
          "id": "NE009",
          "en": "Tell me about it.",
          "ru": "И не говори!",
          "uz": "Aytmang-a!"
        },
        {
          "id": "NE010",
          "en": "You can say that again.",
          "ru": "Ещё бы! / Полностью согласен(на).",
          "uz": "Shunisi rost! / Toʻliq qoʻshilaman."
        }
      ]
    },
    {
      "id": "NE-L02",
      "order": 2,
      "title": {
        "en": "Common informal phrases",
        "ru": "Частые неформальные фразы",
        "uz": "Koʻp ishlatiladigan norasmiy iboralar"
      },
      "phrases": [
        {
          "id": "NE011",
          "en": "What's up?",
          "ru": "Что нового? / Как дела?",
          "uz": "Nima gaplar? / Qalaysiz?"
        },
        {
          "id": "NE012",
          "en": "I'm good.",
          "ru": "У меня всё хорошо.",
          "uz": "Menda hammasi yaxshi."
        },
        {
          "id": "NE013",
          "en": "Not much.",
          "ru": "Ничего особенного.",
          "uz": "Alohida gap yoʻq."
        },
        {
          "id": "NE014",
          "en": "No big deal.",
          "ru": "Ничего страшного.",
          "uz": "Hechqisi yoʻq."
        },
        {
          "id": "NE015",
          "en": "My bad.",
          "ru": "Моя вина.",
          "uz": "Mening aybim."
        },
        {
          "id": "NE016",
          "en": "I'm in.",
          "ru": "Я согласен / я участвую.",
          "uz": "Men roziman, qatnashaman."
        },
        {
          "id": "NE017",
          "en": "I'm out.",
          "ru": "Я пас.",
          "uz": "Men qatnashmayman."
        },
        {
          "id": "NE018",
          "en": "Sounds like a plan.",
          "ru": "Отличный план.",
          "uz": "Zoʻr reja."
        },
        {
          "id": "NE019",
          "en": "Works for me.",
          "ru": "Меня устраивает.",
          "uz": "Menga toʻgʻri keladi."
        },
        {
          "id": "NE020",
          "en": "I'm down for that.",
          "ru": "Я за / я не против.",
          "uz": "Men roziman, qarshi emasman."
        }
      ]
    },
    {
      "id": "NE-L03",
      "order": 3,
      "title": {
        "en": "Natural agreement",
        "ru": "Естественное согласие",
        "uz": "Tabiiy rozilik"
      },
      "phrases": [
        {
          "id": "NE021",
          "en": "Absolutely.",
          "ru": "Определённо.",
          "uz": "Albatta."
        },
        {
          "id": "NE022",
          "en": "For sure.",
          "ru": "Точно. / Конечно.",
          "uz": "Aniq. / Tabiiy."
        },
        {
          "id": "NE023",
          "en": "Totally.",
          "ru": "Полностью согласен(на).",
          "uz": "Toʻliq qoʻshilaman."
        },
        {
          "id": "NE024",
          "en": "You bet.",
          "ru": "Ещё бы. / Конечно.",
          "uz": "Shubhasiz. / Albatta."
        },
        {
          "id": "NE025",
          "en": "I'm with you on that.",
          "ru": "В этом я с тобой согласен(на).",
          "uz": "Bunda men siz bilan birdamman."
        },
        {
          "id": "NE026",
          "en": "Couldn't have said it better.",
          "ru": "Лучше и не скажешь.",
          "uz": "Bundan yaxshiroq aytib boʻlmaydi."
        },
        {
          "id": "NE027",
          "en": "That's exactly it.",
          "ru": "Именно так.",
          "uz": "Aynan shunday."
        },
        {
          "id": "NE028",
          "en": "I'm all for it.",
          "ru": "Я полностью за.",
          "uz": "Men toʻliq tarafdorman."
        },
        {
          "id": "NE029",
          "en": "Count me in.",
          "ru": "Считайте меня участником.",
          "uz": "Meni ham hisobga oling."
        },
        {
          "id": "NE030",
          "en": "You've got a point there.",
          "ru": "В этом ты прав(а).",
          "uz": "Bunda siz haqsiz."
        }
      ]
    },
    {
      "id": "NE-L04",
      "order": 4,
      "title": {
        "en": "Natural disagreement",
        "ru": "Естественное несогласие",
        "uz": "Tabiiy eʼtiroz"
      },
      "phrases": [
        {
          "id": "NE031",
          "en": "I don't know about that.",
          "ru": "Не уверен(а) насчёт этого.",
          "uz": "Bunisiga ishonchim yoʻq."
        },
        {
          "id": "NE032",
          "en": "I'm not so sure.",
          "ru": "Я не так уж уверен(а).",
          "uz": "Ishonchim unchalik komil emas."
        },
        {
          "id": "NE033",
          "en": "Not quite.",
          "ru": "Не совсем.",
          "uz": "Unchalik emas."
        },
        {
          "id": "NE034",
          "en": "I wouldn't go that far.",
          "ru": "Я бы не стал(а) так далеко заходить.",
          "uz": "Men bunchalik deb aytmagan boʻlardim."
        },
        {
          "id": "NE035",
          "en": "That's not how I see it.",
          "ru": "Я вижу это иначе.",
          "uz": "Men buni boshqacha koʻraman."
        },
        {
          "id": "NE036",
          "en": "I beg to differ.",
          "ru": "Позволю себе не согласиться.",
          "uz": "Rozi boʻlmasligimga ijozat bering."
        },
        {
          "id": "NE037",
          "en": "Maybe, but...",
          "ru": "Возможно, но...",
          "uz": "Boʻlishi mumkin, lekin..."
        },
        {
          "id": "NE038",
          "en": "I get what you're saying, but...",
          "ru": "Я понимаю, что ты говоришь, но...",
          "uz": "Nima deyayotganingizni tushunaman, lekin..."
        },
        {
          "id": "NE039",
          "en": "I'm not buying it.",
          "ru": "Я в это не верю.",
          "uz": "Men bunga ishonmayman."
        },
        {
          "id": "NE040",
          "en": "Let's agree to disagree.",
          "ru": "Давай останемся каждый при своём мнении.",
          "uz": "Keling, har birimiz oʻz fikrimizda qolaylik."
        }
      ]
    },
    {
      "id": "NE-L05",
      "order": 5,
      "title": {
        "en": "Sounding less formal",
        "ru": "Менее формальная речь",
        "uz": "Kamroq rasmiy nutq"
      },
      "phrases": [
        {
          "id": "NE041",
          "en": "A bit",
          "ru": "Немного.",
          "uz": "Biroz."
        },
        {
          "id": "NE042",
          "en": "Kind of",
          "ru": "Вроде как; своего рода.",
          "uz": "Qandaydir; bir turdagi."
        },
        {
          "id": "NE043",
          "en": "Sort of",
          "ru": "В некотором смысле.",
          "uz": "Maʼlum maʼnoda."
        },
        {
          "id": "NE044",
          "en": "Pretty much",
          "ru": "В основном; практически.",
          "uz": "Asosan; deyarli."
        },
        {
          "id": "NE045",
          "en": "More or less",
          "ru": "Более или менее.",
          "uz": "Ozmi-koʻpmi; taxminan."
        },
        {
          "id": "NE046",
          "en": "A bunch of",
          "ru": "Много; целая куча.",
          "uz": "Koʻp; bir talay."
        },
        {
          "id": "NE047",
          "en": "Loads of",
          "ru": "Очень много.",
          "uz": "Juda koʻp."
        },
        {
          "id": "NE048",
          "en": "A couple of",
          "ru": "Пара; несколько.",
          "uz": "Bir juft; bir nechta."
        },
        {
          "id": "NE049",
          "en": "Stuff like that",
          "ru": "Что-то в этом роде.",
          "uz": "Shunga oʻxshash narsalar."
        },
        {
          "id": "NE050",
          "en": "And things like that",
          "ru": "И тому подобное.",
          "uz": "Va shunga oʻxshaganlar."
        }
      ]
    },
    {
      "id": "NE-L06",
      "order": 6,
      "title": {
        "en": "Talking about plans",
        "ru": "Разговор о планах",
        "uz": "Rejalar haqida suhbat"
      },
      "phrases": [
        {
          "id": "NE051",
          "en": "I'm up for it.",
          "ru": "Я не против / я за.",
          "uz": "Men roziman."
        },
        {
          "id": "NE052",
          "en": "Let's play it by ear.",
          "ru": "Будем решать по ходу дела.",
          "uz": "Keling, vaziyatga qarab hal qilamiz."
        },
        {
          "id": "NE053",
          "en": "I'm not sure yet.",
          "ru": "Я пока не уверен(а).",
          "uz": "Hozircha ishonchim komil emas."
        },
        {
          "id": "NE054",
          "en": "I'll see how I feel.",
          "ru": "Посмотрю по самочувствию.",
          "uz": "Oʻzimni qanday his qilishimga qarab koʻraman."
        },
        {
          "id": "NE055",
          "en": "Let's see what happens.",
          "ru": "Посмотрим, что будет.",
          "uz": "Koʻramiz, nima boʻlarkin."
        },
        {
          "id": "NE056",
          "en": "I'm thinking about it.",
          "ru": "Я об этом думаю.",
          "uz": "Men bu haqda oʻylayapman."
        },
        {
          "id": "NE057",
          "en": "I'm leaning toward staying in.",
          "ru": "Я склоняюсь к тому, чтобы остаться дома.",
          "uz": "Men uyda qolishga moyilman."
        },
        {
          "id": "NE058",
          "en": "It's still up in the air.",
          "ru": "Это пока не решено.",
          "uz": "Bu hali hal boʻlgani yoʻq."
        },
        {
          "id": "NE059",
          "en": "I'll keep you posted.",
          "ru": "Буду держать тебя в курсе.",
          "uz": "Sizni xabardor qilib turaman."
        },
        {
          "id": "NE060",
          "en": "Let's make it happen.",
          "ru": "Давай сделаем так, чтобы это произошло.",
          "uz": "Keling, buni amalga oshiraylik."
        }
      ]
    },
    {
      "id": "NE-L07",
      "order": 7,
      "title": {
        "en": "Reassuring naturally",
        "ru": "Естественное успокоение",
        "uz": "Tabiiy tinchlantirish"
      },
      "phrases": [
        {
          "id": "NE061",
          "en": "You're all good.",
          "ru": "Всё нормально.",
          "uz": "Hammasi joyida."
        },
        {
          "id": "NE062",
          "en": "Don't sweat it.",
          "ru": "Не переживай.",
          "uz": "Xavotir olmang."
        },
        {
          "id": "NE063",
          "en": "It's all good.",
          "ru": "Всё хорошо.",
          "uz": "Hammasi yaxshi."
        },
        {
          "id": "NE064",
          "en": "No biggie.",
          "ru": "Ничего страшного.",
          "uz": "Katta gap emas."
        },
        {
          "id": "NE065",
          "en": "It'll work out.",
          "ru": "Всё наладится.",
          "uz": "Hammasi yaxshi boʻlib ketadi."
        },
        {
          "id": "NE066",
          "en": "We've all been there.",
          "ru": "Со всеми такое бывало.",
          "uz": "Bu hammamizning boshimizdan oʻtgan."
        },
        {
          "id": "NE067",
          "en": "Take it easy.",
          "ru": "Не переживай; полегче.",
          "uz": "Xotirjam boʻling; shoshilmang."
        },
        {
          "id": "NE068",
          "en": "You're doing fine.",
          "ru": "У тебя всё хорошо получается.",
          "uz": "Sizda yaxshi chiqyapti."
        },
        {
          "id": "NE069",
          "en": "It's not the end of the world.",
          "ru": "Это не конец света.",
          "uz": "Bu dunyoning oxiri emas."
        },
        {
          "id": "NE070",
          "en": "One thing at a time.",
          "ru": "По одному делу за раз.",
          "uz": "Bir vaqtda bitta ish."
        }
      ]
    },
    {
      "id": "NE-L08",
      "order": 8,
      "title": {
        "en": "Everyday emphasis",
        "ru": "Усиление мысли",
        "uz": "Fikrni kuchaytirish"
      },
      "phrases": [
        {
          "id": "NE071",
          "en": "I literally can't.",
          "ru": "Я буквально не могу (разг.).",
          "uz": "Men chindan ham qila olmayman (soʻzlashuv)."
        },
        {
          "id": "NE072",
          "en": "I'm so done with this.",
          "ru": "С меня хватит этого.",
          "uz": "Bu jonimga tegdi."
        },
        {
          "id": "NE073",
          "en": "That's a whole different story.",
          "ru": "Это совсем другая история.",
          "uz": "Bu butunlay boshqa gap."
        },
        {
          "id": "NE074",
          "en": "It's such a pain.",
          "ru": "Это такая морока.",
          "uz": "Bu juda ovora qiladigan ish."
        },
        {
          "id": "NE075",
          "en": "I'm really into it.",
          "ru": "Мне это очень нравится.",
          "uz": "Bu menga juda yoqadi."
        },
        {
          "id": "NE076",
          "en": "It's super easy.",
          "ru": "Это очень просто.",
          "uz": "Bu juda oson."
        },
        {
          "id": "NE077",
          "en": "I'm dead tired.",
          "ru": "Я смертельно устал(а).",
          "uz": "Men oʻlguday charchadim."
        },
        {
          "id": "NE078",
          "en": "That was a close call.",
          "ru": "Чуть не случилась беда.",
          "uz": "Sal boʻlmasa falokat yuz berardi."
        },
        {
          "id": "NE079",
          "en": "It's way too expensive.",
          "ru": "Это слишком дорого.",
          "uz": "Bu juda ham qimmat."
        },
        {
          "id": "NE080",
          "en": "I'm not even joking.",
          "ru": "Я даже не шучу.",
          "uz": "Men hazillashayotganim ham yoʻq."
        }
      ]
    },
    {
      "id": "NE-L09",
      "order": 9,
      "title": {
        "en": "Softening what you say",
        "ru": "Смягчение высказываний",
        "uz": "Gapni yumshatish"
      },
      "phrases": [
        {
          "id": "NE081",
          "en": "I guess...",
          "ru": "Полагаю...",
          "uz": "Menimcha..."
        },
        {
          "id": "NE082",
          "en": "I suppose...",
          "ru": "Думаю... / Полагаю...",
          "uz": "Oʻylaymanki... / Taxminimcha..."
        },
        {
          "id": "NE083",
          "en": "Maybe it's just me, but...",
          "ru": "Может, это только мне кажется, но...",
          "uz": "Balki menga shunday tuyulayotgandir, lekin..."
        },
        {
          "id": "NE084",
          "en": "I could be wrong.",
          "ru": "Возможно, я ошибаюсь.",
          "uz": "Men adashayotgan boʻlishim mumkin."
        },
        {
          "id": "NE085",
          "en": "As far as I can tell...",
          "ru": "Насколько я могу судить...",
          "uz": "Men bilganimcha..."
        },
        {
          "id": "NE086",
          "en": "If that makes sense.",
          "ru": "Если я понятно объяснил(а).",
          "uz": "Agar tushunarli tushuntirgan boʻlsam."
        },
        {
          "id": "NE087",
          "en": "I don't mean to be rude.",
          "ru": "Я не хочу показаться грубым / грубой.",
          "uz": "Qoʻpol koʻrinishni istamayman."
        },
        {
          "id": "NE088",
          "en": "To be fair...",
          "ru": "Справедливости ради...",
          "uz": "Adolat yuzasidan aytganda..."
        },
        {
          "id": "NE089",
          "en": "I see what you mean, though.",
          "ru": "Хотя я понимаю, что ты имеешь в виду.",
          "uz": "Baribir nimani nazarda tutayotganingizni tushunaman."
        },
        {
          "id": "NE090",
          "en": "That's just my take on it.",
          "ru": "Это просто мой взгляд на ситуацию.",
          "uz": "Bu shunchaki mening qarashim."
        }
      ]
    },
    {
      "id": "NE-L10",
      "order": 10,
      "title": {
        "en": "Telling stories",
        "ru": "Рассказ историй",
        "uz": "Voqea hikoya qilish"
      },
      "phrases": [
        {
          "id": "NE091",
          "en": "So, guess what happened.",
          "ru": "Так вот, угадай, что случилось.",
          "uz": "Xullas, nima boʻldi deb oʻylaysiz?"
        },
        {
          "id": "NE092",
          "en": "Long story short...",
          "ru": "Короче говоря...",
          "uz": "Qisqasi..."
        },
        {
          "id": "NE093",
          "en": "You won't believe this.",
          "ru": "Ты в это не поверишь.",
          "uz": "Bunga ishonmaysiz."
        },
        {
          "id": "NE094",
          "en": "Here's the funny part.",
          "ru": "А вот тут самое смешное.",
          "uz": "Eng qizigʻi shu yerda."
        },
        {
          "id": "NE095",
          "en": "Out of nowhere...",
          "ru": "Совершенно неожиданно...",
          "uz": "Kutilmaganda..."
        },
        {
          "id": "NE096",
          "en": "Before I knew it...",
          "ru": "Не успел(а) я опомниться, как...",
          "uz": "Men oʻzimga kelgunimcha..."
        },
        {
          "id": "NE097",
          "en": "Next thing I knew...",
          "ru": "И вдруг оказалось, что...",
          "uz": "Birdan maʼlum boʻldiki..."
        },
        {
          "id": "NE098",
          "en": "It turned out that...",
          "ru": "Оказалось, что...",
          "uz": "Maʼlum boʻlishicha..."
        },
        {
          "id": "NE099",
          "en": "The best part was...",
          "ru": "Самое лучшее было то, что...",
          "uz": "Eng yaxshi tomoni shu ediki..."
        },
        {
          "id": "NE100",
          "en": "That's how it all started.",
          "ru": "Вот так всё и началось.",
          "uz": "Mana shunday hammasi boshlangan."
        }
      ]
    },
    {
      "id": "NE-L11",
      "order": 11,
      "title": {
        "en": "Everyday idiomatic phrases",
        "ru": "Идиоматические фразы",
        "uz": "Kundalik idiomatik iboralar"
      },
      "phrases": [
        {
          "id": "NE101",
          "en": "It's up to you.",
          "ru": "Решать тебе.",
          "uz": "Oʻzingiz hal qiling."
        },
        {
          "id": "NE102",
          "en": "Give it a shot.",
          "ru": "Попробуй.",
          "uz": "Bir urinib koʻring."
        },
        {
          "id": "NE103",
          "en": "Hang in there.",
          "ru": "Держись.",
          "uz": "Bardosh bering."
        },
        {
