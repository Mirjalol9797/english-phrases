  "lessons": [
    {
      "id": "NE-L01",
      "order": 1,
      "title": {
        "en": "Natural reactions",
        "ru": "Естественные реакции"
      },
      "phrases": [
        {
          "id": "NE001",
          "en": "No way!",
          "ru": "Да ладно! / Не может быть!"
        },
        {
          "id": "NE002",
          "en": "You must be kidding.",
          "ru": "Ты, должно быть, шутишь."
        },
        {
          "id": "NE003",
          "en": "That figures.",
          "ru": "Так и думал(а). / Неудивительно."
        },
        {
          "id": "NE004",
          "en": "Fair enough.",
          "ru": "Ладно, справедливо."
        },
        {
          "id": "NE005",
          "en": "I get it.",
          "ru": "Понимаю."
        },
        {
          "id": "NE006",
          "en": "Makes sense.",
          "ru": "Логично."
        },
        {
          "id": "NE007",
          "en": "Good point.",
          "ru": "Хорошее замечание."
        },
        {
          "id": "NE008",
          "en": "I hear you.",
          "ru": "Я тебя понимаю."
        },
        {
          "id": "NE009",
          "en": "Tell me about it.",
          "ru": "И не говори!"
        },
        {
          "id": "NE010",
          "en": "You can say that again.",
          "ru": "Ещё бы! / Полностью согласен(на)."
        }
      ]
    },
    {
