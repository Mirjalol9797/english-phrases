      "phrases": [
        {
          "id": "NE011",
          "en": "What's up?",
          "ru": "Что нового? / Как дела?"
        },
        {
          "id": "NE012",
          "en": "I'm good.",
          "ru": "У меня всё хорошо."
        },
        {
          "id": "NE013",
          "en": "Not much.",
          "ru": "Ничего особенного."
        },
        {
          "id": "NE014",
          "en": "No big deal.",
          "ru": "Ничего страшного."
        },
        {
          "id": "NE015",
          "en": "My bad.",
          "ru": "Моя вина."
        },
        {
          "id": "NE016",
          "en": "I'm in.",
          "ru": "Я согласен / я участвую."
        },
        {
          "id": "NE017",
          "en": "I'm out.",
          "ru": "Я пас."
        },
        {
          "id": "NE018",
          "en": "Sounds like a plan.",
          "ru": "Отличный план."
        },
        {
          "id": "NE019",
          "en": "Works for me.",
          "ru": "Меня устраивает."
        },
        {
          "id": "NE020",
          "en": "I'm down for that.",
          "ru": "Я за / я не против."
        }
      ]
    },
    {
