  },
  "lessons": [
    {
      "id": "PM-L01",
      "order": 1,
      "title": {
        "en": "Starting a call",
        "ru": "Начало звонка",
        "uz": "Qoʻngʻiroq boshlanishi"
      },
      "phrases": [
        {
          "id": "PM001",
          "en": "Hi, it's me.",
          "ru": "Привет, это я.",
          "uz": "Salom, bu men."
        },
        {
          "id": "PM002",
          "en": "Is now a good time to talk?",
          "ru": "Сейчас удобно говорить?",
          "uz": "Hozir gaplashish qulaymi?"
        },
        {
          "id": "PM003",
          "en": "Can you talk for a minute?",
          "ru": "Можешь поговорить минутку?",
          "uz": "Bir daqiqa gaplasha olasizmi?"
        },
        {
          "id": "PM004",
          "en": "Am I calling at a bad time?",
          "ru": "Я не вовремя звоню?",
          "uz": "Notoʻgʻri vaqtda qoʻngʻiroq qilyapmanmi?"
        },
        {
          "id": "PM005",
          "en": "I just wanted to check in.",
          "ru": "Я просто хотел(а) узнать, как ты.",
          "uz": "Shunchaki hol-ahvolingizni bilmoqchi edim."
        },
        {
          "id": "PM006",
          "en": "I thought I'd give you a call.",
          "ru": "Я подумал(а), что позвоню тебе.",
          "uz": "Sizga qoʻngʻiroq qilay dedim."
        },
        {
          "id": "PM007",
          "en": "Can you hear me okay?",
          "ru": "Ты меня нормально слышишь?",
          "uz": "Meni yaxshi eshityapsizmi?"
        },
        {
          "id": "PM008",
          "en": "Sorry, I missed your call.",
          "ru": "Извини, я пропустил(а) твой звонок.",
          "uz": "Kechirasiz, qoʻngʻirogʻingizni oʻtkazib yuboribman."
        },
        {
          "id": "PM009",
          "en": "Thanks for calling me back.",
          "ru": "Спасибо, что перезвонил(а).",
          "uz": "Qayta qoʻngʻiroq qilganingiz uchun rahmat."
        },
        {
          "id": "PM010",
          "en": "What's up?",
          "ru": "Что случилось? / Как дела?",
          "uz": "Nima gap?"
        }
      ]
    },
    {
      "id": "PM-L02",
      "order": 2,
      "title": {
        "en": "Making and answering calls",
        "ru": "Звонки",
        "uz": "Qoʻngʻiroqlar"
      },
      "phrases": [
        {
          "id": "PM011",
          "en": "Could I speak to Alex, please?",
          "ru": "Можно поговорить с Алексом, пожалуйста?",
          "uz": "Iltimos, Aleks bilan gaplashsam boʻladimi?"
        },
        {
          "id": "PM012",
          "en": "Who's calling, please?",
          "ru": "Кто звонит, пожалуйста?",
          "uz": "Kim qoʻngʻiroq qilyapti?"
        },
        {
          "id": "PM013",
          "en": "Please hold for a moment.",
          "ru": "Пожалуйста, подождите минутку.",
          "uz": "Iltimos, bir daqiqa kutib turing."
        },
        {
          "id": "PM014",
          "en": "I'll put you through.",
          "ru": "Я соединю вас.",
          "uz": "Sizni ulayman."
        },
        {
          "id": "PM015",
          "en": "Could you call back later?",
          "ru": "Не могли бы вы перезвонить позже?",
          "uz": "Keyinroq qayta qoʻngʻiroq qila olasizmi?"
        },
        {
          "id": "PM016",
          "en": "The line is busy.",
          "ru": "Линия занята.",
          "uz": "Liniya band."
        },
        {
          "id": "PM017",
          "en": "I think we got disconnected.",
          "ru": "Кажется, связь прервалась.",
          "uz": "Aloqa uzilib qoldi shekilli."
        },
        {
          "id": "PM018",
          "en": "I'll call you right back.",
          "ru": "Я сейчас же перезвоню.",
          "uz": "Hozir qayta qoʻngʻiroq qilaman."
        },
        {
          "id": "PM019",
          "en": "Can I leave a message?",
          "ru": "Могу я оставить сообщение?",
          "uz": "Xabar qoldirsam boʻladimi?"
        },
        {
          "id": "PM020",
          "en": "Could you ask them to call me?",
          "ru": "Не могли бы вы попросить их мне позвонить?",
          "uz": "Ularga menga qoʻngʻiroq qilishni aytib qoʻya olasizmi?"
        }
      ]
    },
    {
      "id": "PM-L03",
      "order": 3,
      "title": {
        "en": "Poor connection",
        "ru": "Плохая связь",
        "uz": "Aloqa yomonligi"
      },
      "phrases": [
        {
          "id": "PM021",
          "en": "You're breaking up.",
          "ru": "Тебя плохо слышно, связь прерывается.",
          "uz": "Ovozingiz uzilib-uzilib kelyapti."
        },
        {
          "id": "PM022",
          "en": "I can barely hear you.",
          "ru": "Я едва тебя слышу.",
          "uz": "Sizni zoʻrgʻa eshityapman."
        },
        {
          "id": "PM023",
          "en": "The signal is weak.",
          "ru": "Слабый сигнал.",
          "uz": "Signal kuchsiz."
        },
        {
          "id": "PM024",
          "en": "Could you move somewhere quieter?",
          "ru": "Можешь перейти в более тихое место?",
          "uz": "Tinchroq joyga oʻta olasizmi?"
        },
        {
          "id": "PM025",
          "en": "There's a lot of background noise.",
          "ru": "Много фонового шума.",
          "uz": "Fonda shovqin koʻp."
        },
        {
          "id": "PM026",
          "en": "Your voice keeps cutting out.",
          "ru": "Твой голос постоянно пропадает.",
          "uz": "Ovozingiz tinmay uzilyapti."
        },
        {
          "id": "PM027",
          "en": "Let me call you back from another phone.",
          "ru": "Позволь перезвонить с другого телефона.",
          "uz": "Boshqa telefondan qayta qoʻngʻiroq qilay."
        },
        {
          "id": "PM028",
          "en": "I think the connection is unstable.",
          "ru": "Кажется, соединение нестабильное.",
          "uz": "Aloqa barqaror emas shekilli."
        },
        {
          "id": "PM029",
          "en": "Can you hear me now?",
          "ru": "Теперь ты меня слышишь?",
          "uz": "Endi eshityapsizmi?"
        },
        {
          "id": "PM030",
          "en": "Let's switch to a video call.",
          "ru": "Давай перейдём на видеозвонок.",
          "uz": "Keling, videoqoʻngʻiroqqa oʻtaylik."
        }
      ]
    },
    {
      "id": "PM-L04",
      "order": 4,
      "title": {
        "en": "Leaving messages",
        "ru": "Оставление сообщений",
        "uz": "Xabar qoldirish"
      },
      "phrases": [
        {
          "id": "PM031",
          "en": "Please leave a message after the beep.",
          "ru": "Оставьте сообщение после сигнала.",
          "uz": "Signaldan keyin xabar qoldiring."
        },
        {
          "id": "PM032",
          "en": "I just called to let you know...",
          "ru": "Я просто позвонил(а), чтобы сообщить...",
          "uz": "Shunchaki xabar berish uchun qoʻngʻiroq qildim..."
        },
        {
          "id": "PM033",
          "en": "Could you pass on a message?",
          "ru": "Не могли бы вы передать сообщение?",
          "uz": "Xabarni yetkazib qoʻya olasizmi?"
        },
        {
          "id": "PM034",
          "en": "Please tell them I called.",
          "ru": "Пожалуйста, скажите им, что я звонил(а).",
          "uz": "Iltimos, ularga qoʻngʻiroq qilganimni ayting."
        },
        {
          "id": "PM035",
          "en": "I'll try again later.",
          "ru": "Я попробую ещё раз позже.",
          "uz": "Keyinroq yana urinib koʻraman."
        },
        {
          "id": "PM036",
          "en": "I couldn't reach you.",
          "ru": "Я не смог(ла) до тебя дозвониться.",
          "uz": "Sizga dozvon qila olmadim."
        },
        {
          "id": "PM037",
          "en": "I left you a voicemail.",
          "ru": "Я оставил(а) тебе голосовое сообщение.",
          "uz": "Sizga ovozli xabar qoldirdim."
        },
        {
          "id": "PM038",
          "en": "Did you get my message?",
          "ru": "Ты получил(а) моё сообщение?",
          "uz": "Xabarimni oldingizmi?"
        },
        {
          "id": "PM039",
          "en": "Please call me when you can.",
          "ru": "Позвони мне, когда сможешь.",
          "uz": "Imkoningiz boʻlganda menga qoʻngʻiroq qiling."
        },
        {
          "id": "PM040",
          "en": "It's nothing urgent.",
          "ru": "Это не срочно.",
          "uz": "Bu shoshilinch emas."
        }
      ]
    },
    {
      "id": "PM-L05",
      "order": 5,
      "title": {
        "en": "Text messages",
        "ru": "Текстовые сообщения",
        "uz": "Matnli xabarlar"
      },
      "phrases": [
        {
          "id": "PM041",
          "en": "I'll text you the details.",
          "ru": "Я напишу тебе подробности.",
          "uz": "Tafsilotlarini yozib yuboraman."
        },
        {
          "id": "PM042",
          "en": "Did you see my text?",
          "ru": "Ты видел(а) моё сообщение?",
          "uz": "Xabarimni koʻrdingizmi?"
        },
        {
          "id": "PM043",
          "en": "Sorry, I just saw this.",
          "ru": "Извини, я только сейчас это увидел(а).",
          "uz": "Kechirasiz, buni endi koʻrdim."
        },
        {
          "id": "PM044",
          "en": "I'll reply in a minute.",
          "ru": "Я отвечу через минуту.",
          "uz": "Bir daqiqadan keyin javob beraman."
        },
        {
          "id": "PM045",
          "en": "Can you send that again?",
          "ru": "Можешь отправить это ещё раз?",
          "uz": "Buni qayta yuborib bera olasizmi?"
        },
        {
          "id": "PM046",
          "en": "I sent it by mistake.",
          "ru": "Я отправил(а) это по ошибке.",
          "uz": "Buni adashib yuboribman."
        },
        {
          "id": "PM047",
          "en": "Please check your messages.",
          "ru": "Пожалуйста, проверь сообщения.",
          "uz": "Iltimos, xabarlaringizni tekshiring."
        },
        {
          "id": "PM048",
          "en": "I'll message you later.",
          "ru": "Я напишу тебе позже.",
          "uz": "Keyinroq yozaman."
        },
        {
          "id": "PM049",
          "en": "I haven't heard back from them.",
          "ru": "Они мне пока не ответили.",
          "uz": "Ulardan hali javob kelmadi."
        },
        {
          "id": "PM050",
          "en": "Thanks for the heads-up.",
          "ru": "Спасибо, что предупредил(а).",
          "uz": "Ogohlantirganingiz uchun rahmat."
        }
      ]
    },
    {
      "id": "PM-L06",
      "order": 6,
      "title": {
        "en": "Making plans by phone",
        "ru": "Договорённости по телефону",
        "uz": "Telefon orqali kelishuvlar"
      },
      "phrases": [
        {
          "id": "PM051",
          "en": "Are we still on for tonight?",
          "ru": "Наши планы на сегодняшний вечер в силе?",
          "uz": "Bugun kechqurungi rejamiz kuchidami?"
        },
        {
          "id": "PM052",
          "en": "What time should I call you?",
          "ru": "Во сколько мне тебе позвонить?",
          "uz": "Sizga soat nechada qoʻngʻiroq qilay?"
        },
        {
          "id": "PM053",
          "en": "I'll send you the address.",
          "ru": "Я отправлю тебе адрес.",
          "uz": "Manzilni yuboraman."
        },
        {
          "id": "PM054",
          "en": "Can you share your location?",
          "ru": "Можешь поделиться геолокацией?",
          "uz": "Joylashuvingizni ulasha olasizmi?"
        },
        {
          "id": "PM055",
          "en": "Let's confirm the details by text.",
          "ru": "Давай подтвердим детали сообщением.",
          "uz": "Keling, tafsilotlarni xabar orqali tasdiqlaylik."
        },
        {
          "id": "PM056",
          "en": "I'll let you know when I'm leaving.",
          "ru": "Я сообщу тебе, когда выйду.",
          "uz": "Chiqayotganimda xabar beraman."
        },
        {
          "id": "PM057",
          "en": "I'm running a little late.",
          "ru": "Я немного опаздываю.",
          "uz": "Men biroz kechikyapman."
        },
        {
          "id": "PM058",
          "en": "I'll be there in ten minutes.",
          "ru": "Я буду там через десять минут.",
          "uz": "Oʻn daqiqada yetib boraman."
        },
        {
          "id": "PM059",
          "en": "Something came up; can we reschedule?",
          "ru": "Возникли обстоятельства; можем перенести?",
          "uz": "Ish chiqib qoldi; boshqa vaqtga koʻchira olamizmi?"
        },
        {
          "id": "PM060",
          "en": "Call me when you're on your way.",
          "ru": "Позвони мне, когда будешь в пути.",
          "uz": "Yoʻlga chiqqaningizda qoʻngʻiroq qiling."
        }
      ]
    },
    {
      "id": "PM-L07",
      "order": 7,
      "title": {
        "en": "Video calls",
        "ru": "Видеозвонки",
        "uz": "Videoqoʻngʻiroqlar"
      },
      "phrases": [
        {
          "id": "PM061",
          "en": "Can you turn your camera on?",
          "ru": "Можешь включить камеру?",
          "uz": "Kamerangizni yoqa olasizmi?"
        },
        {
          "id": "PM062",
          "en": "Your camera is frozen.",
          "ru": "Твоё изображение зависло.",
          "uz": "Tasviringiz qotib qoldi."
        },
        {
          "id": "PM063",
          "en": "You're on mute.",
          "ru": "У тебя выключен микрофон.",
          "uz": "Mikrofoningiz oʻchiq."
        },
        {
          "id": "PM064",
          "en": "I can't see your screen.",
          "ru": "Я не вижу твой экран.",
          "uz": "Ekraningizni koʻra olmayapman."
        },
        {
          "id": "PM065",
          "en": "Could you share the link?",
          "ru": "Можешь поделиться ссылкой?",
          "uz": "Havolani ulasha olasizmi?"
        },
        {
          "id": "PM066",
          "en": "I'll join in a moment.",
