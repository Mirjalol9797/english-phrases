          "uz": "Qoʻngʻirogʻimga javob berganingiz uchun rahmat."
        },
        {
          "id": "PM088",
          "en": "I have another call coming in.",
          "ru": "Мне поступает другой звонок.",
          "uz": "Menga boshqa qoʻngʻiroq kelyapti."
        },
        {
          "id": "PM089",
          "en": "Can we keep this brief?",
          "ru": "Можем говорить кратко?",
          "uz": "Qisqa qilsak boʻladimi?"
        },
        {
          "id": "PM090",
          "en": "I'll follow up by email.",
          "ru": "Я продолжу общение по электронной почте.",
          "uz": "Elektron pochta orqali davom ettiraman."
        }
      ]
    },
    {
      "id": "PM-L10",
      "order": 10,
      "title": {
        "en": "Polite messaging",
        "ru": "Вежливая переписка",
        "uz": "Xushmuomala yozishma"
      },
      "phrases": [
        {
          "id": "PM091",
