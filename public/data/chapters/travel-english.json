        {
          "id": "TE041",
          "en": "I have a reservation.",
          "ru": "У меня есть бронирование."
        },
        {
          "id": "TE042",
          "en": "I'd like to check in.",
          "ru": "Я хотел(а) бы заселиться."
        },
        {
          "id": "TE043",
          "en": "Could I see the room first?",
          "ru": "Можно сначала посмотреть номер?"
        },
        {
          "id": "TE044",
          "en": "What time is check-out?",
          "ru": "Во сколько нужно выехать?"
        },
        {
          "id": "TE045",
          "en": "Is breakfast included?",
          "ru": "Завтрак включён?"
        },
        {
          "id": "TE046",
          "en": "The air conditioning isn't working.",
          "ru": "Кондиционер не работает."
        },
        {
          "id": "TE047",
          "en": "Could I get an extra towel?",
          "ru": "Можно дополнительное полотенце?"
        },
        {
          "id": "TE048",
          "en": "Is Wi-Fi available?",
          "ru": "Есть ли Wi-Fi?"
        },
        {
          "id": "TE049",
          "en": "Could you call a taxi for me?",
          "ru": "Не могли бы вы вызвать мне такси?"
        },
        {
          "id": "TE050",
          "en": "I'd like to check out, please.",
          "ru": "Я хотел(а) бы выехать из отеля."
        }
      ]
    },
    {
