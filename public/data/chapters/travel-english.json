  "lessons": [
    {
      "id": "TE-L01",
      "order": 1,
      "title": {
        "en": "Planning a trip",
        "ru": "Планирование поездки"
      },
      "phrases": [
        {
          "id": "TE001",
          "en": "I'm planning a trip.",
          "ru": "Я планирую поездку."
        },
        {
          "id": "TE002",
          "en": "Where would you recommend going?",
          "ru": "Куда вы посоветовали бы поехать?"
        },
        {
          "id": "TE003",
          "en": "What's the best time to visit?",
          "ru": "Когда лучше всего приезжать?"
        },
        {
          "id": "TE004",
          "en": "How many days should I stay?",
          "ru": "Сколько дней мне стоит остаться?"
        },
        {
          "id": "TE005",
          "en": "I'd like to travel on a budget.",
          "ru": "Я хотел(а) бы путешествовать экономно."
        },
        {
          "id": "TE006",
          "en": "Is it easy to get around?",
          "ru": "Там легко передвигаться?"
        },
        {
          "id": "TE007",
          "en": "What should I pack?",
          "ru": "Что мне взять с собой?"
        },
        {
          "id": "TE008",
          "en": "Do I need a visa?",
          "ru": "Мне нужна виза?"
        },
        {
          "id": "TE009",
          "en": "I'd like to book in advance.",
          "ru": "Я хотел(а) бы забронировать заранее."
        },
        {
          "id": "TE010",
          "en": "Could you recommend some places to visit?",
          "ru": "Можете порекомендовать места для посещения?"
        }
      ]
    },
    {
