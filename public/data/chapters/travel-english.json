        {
          "id": "TE007",
          "en": "What should I pack?",
          "ru": "Что мне взять с собой?",
          "uz": "Oʻzim bilan nima olishim kerak?"
        },
        {
          "id": "TE008",
          "en": "Do I need a visa?",
          "ru": "Мне нужна виза?",
          "uz": "Menga viza kerakmi?"
        },
        {
          "id": "TE009",
          "en": "I'd like to book in advance.",
          "ru": "Я хотел(а) бы забронировать заранее.",
          "uz": "Oldindan band qilmoqchiman."
        },
        {
          "id": "TE010",
          "en": "Could you recommend some places to visit?",
          "ru": "Можете порекомендовать места для посещения?",
          "uz": "Borishga arziydigan joylarni tavsiya qila olasizmi?"
        }
      ]
