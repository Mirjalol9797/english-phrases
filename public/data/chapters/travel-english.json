      "title": {
        "en": "Immigration and customs",
        "ru": "Паспортный контроль и таможня"
      },
      "phrases": [
        {
          "id": "TE031",
          "en": "What is the purpose of your visit?",
          "ru": "Какова цель вашего визита?"
        },
        {
          "id": "TE032",
          "en": "I'm here on holiday.",
          "ru": "Я приехал(а) в отпуск."
        },
        {
          "id": "TE033",
          "en": "I'm staying for a week.",
          "ru": "Я остаюсь на неделю."
        },
        {
          "id": "TE034",
          "en": "Where will you be staying?",
          "ru": "Где вы будете проживать?"
        },
        {
          "id": "TE035",
          "en": "Here's my hotel reservation.",
          "ru": "Вот бронь моего отеля."
        },
        {
          "id": "TE036",
          "en": "I have a return ticket.",
          "ru": "У меня есть билет обратно."
        },
        {
          "id": "TE037",
          "en": "Do I need to declare anything?",
          "ru": "Мне нужно что-нибудь декларировать?"
        },
        {
          "id": "TE038",
          "en": "I'm travelling with my family.",
          "ru": "Я путешествую с семьёй."
        },
        {
          "id": "TE039",
          "en": "This is my first visit.",
          "ru": "Я здесь впервые."
        },
        {
          "id": "TE040",
          "en": "How long can I stay?",
          "ru": "Как долго я могу здесь находиться?"
        }
      ]
    },
    {
