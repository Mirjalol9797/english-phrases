        },
        {
          "id": "UE065",
          "en": "I can't believe it.",
          "ru": "Не могу в это поверить.",
          "uz": "Bunga ishona olmayman."
        },
        {
          "id": "UE066",
          "en": "That's surprising.",
          "ru": "Это удивительно.",
          "uz": "Bu hayratlanarli."
        },
        {
          "id": "UE067",
          "en": "I didn't expect that.",
          "ru": "Я этого не ожидал(а).",
          "uz": "Men buni kutmagandim."
        },
        {
          "id": "UE068",
          "en": "What a surprise!",
          "ru": "Какой сюрприз!",
          "uz": "Qanday kutilmagan hodisa!"
        },
        {
          "id": "UE069",
          "en": "You've got to be joking.",
          "ru": "Ты, должно быть, шутишь.",
          "uz": "Siz hazillashyapsiz shekilli."
        },
        {
          "id": "UE070",
          "en": "Is that so?",
          "ru": "Вот как? / Неужели?",
          "uz": "Shundaymi? / Nahotki?"
        }
      ]
    },
    {
