{
  "name": "english-phrases",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "data:build": "node scripts/build-data.mjs && node scripts/validate-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "pwa:check": "node scripts/check-pwa.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "uz:dump": "node scripts/translate-chapter.mjs dump",
    "uz:build": "node scripts/translate-chapter.mjs build"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.1",
    "mammoth": "1.12.3",
    "node-html-parser": "9.0.4",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.11"
  }
}
